generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Source {
  id         String   @id @db.VarChar(50)
  name       String   @db.VarChar(100)
  baseUrl    String   @db.Text
  categories Json
  selectors  Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("sources")
}

model User {
  id            String         @id // Supabase Auth UID (String)
  username      String         @unique @db.VarChar(100)
  password      String?        @db.VarChar(255) // Optional if using OAuth
  apiKey        String?        @unique @db.VarChar(100) @map("api_key")
  role          UserRole       @default(user)
  subscriptions Subscription[]
  apiKeys       ApiKey[]
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("users")
}

enum UserRole {
  admin
  user
}

model Plan {
  id             Int            @id @default(autoincrement())
  name           String         @unique @db.VarChar(50)
  price          Decimal        @db.Decimal(10, 2)
  maxRequestsDay Int            @map("max_requests_day")
  features       Json
  subscriptions  Subscription[]
  createdAt      DateTime       @default(now()) @map("created_at")

  @@map("plans")
}

model Subscription {
  id        Int                @id @default(autoincrement())
  userId    String             @map("user_id")
  planId    Int                @map("plan_id")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])
  startDate DateTime           @default(now()) @map("start_date")
  endDate   DateTime?          @map("end_date")
  status    SubscriptionStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at")

  @@map("subscriptions")
}

enum SubscriptionStatus {
  active
  expired
  canceled
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(100)
  keyValue  String   @unique @db.VarChar(100) @map("key_value")
  isActive  Boolean  @default(true) @map("is_active")
  logs      ApiLog[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("api_keys")
}

model ApiLog {
  id           Int      @id @default(autoincrement())
  keyId        Int      @map("key_id")
  apiKey       ApiKey   @relation(fields: [keyId], references: [id], onDelete: Cascade)
  endpoint     String   @db.VarChar(255)
  method       String   @db.VarChar(10)
  statusCode   Int      @map("status_code")
  responseTime Int      @map("response_time")
  ipAddress    String?  @db.VarChar(45) @map("ip_address")
  timestamp    DateTime @default(now())

  @@map("api_logs")
}
